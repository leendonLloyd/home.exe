# Firebase web config. Set these as GitHub repository variables (Settings →
# Secrets and variables → Actions → Variables) for the deployed build, and copy
# this file to .env.local with the real values for local development.
#
# These are not secrets — a Firebase web config is public by design and ends up
# in the bundle regardless. firebase/firestore.rules is what gates the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Apps Script web app for the wedding planner sheet (To Do, Payments).
# This one IS a credential — the deployment is open to anyone with the link —
# but it is inlined into the bundle regardless, so treat the deployed site as
# the exposure and rotate by archiving the deployment rather than by hiding it.
VITE_SHEET_EXEC_URL=
